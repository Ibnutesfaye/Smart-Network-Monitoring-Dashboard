# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database (PostgreSQL)
# Docker Compose: DB_HOST=db
# Local Windows/Mac Postgres: DB_HOST=localhost
DB_NAME=snmadmdcp
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Monitoring
MONITORING_MODE=mock
SUBNET_CIDR=192.168.1.0/24
DISCOVERY_MAX_HOSTS=256
DISCOVERY_BATCH_SIZE=32
DISCOVERY_MAX_SEGMENTS_PER_RUN=20
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RECOVERY_THRESHOLD=2
MONITOR_PING_TIMEOUT_MS=1000
MONITOR_PING_ATTEMPTS=3
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_CLEANUP_BATCH_SIZE=5000

# SNMP secrets are external environment values and are never returned by the API.
SNMP_TIMEOUT_SECONDS=2
SNMP_RETRIES=1
SNMP_COMMUNITY=
SNMP_V3_USERNAME=
SNMP_V3_AUTH_KEY=
SNMP_V3_PRIV_KEY=
SNMP_V3_SECURITY_LEVEL=authPriv
SNMP_V3_AUTH_PROTOCOL=SHA256
SNMP_V3_PRIV_PROTOCOL=AES128

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@snmadmdcp.local

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000

# Development compatibility only. Production rejects access tokens in URLs.
WEBSOCKET_ALLOW_QUERY_AUTH=True

# Never enable in production. Demo accounts are created only by an explicit command.
ALLOW_DEMO_SEED=False
